NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Local development can use data/store.json. Production requires PostgreSQL.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_SIZE=10

# Required in production. The first run creates a private developer account.
SESSION_SECRET=
BOOTSTRAP_DEVELOPER_NAME=
BOOTSTRAP_DEVELOPER_EMAIL=
BOOTSTRAP_DEVELOPER_PASSWORD=

# Resend email
RESEND_API_KEY=
EMAIL_FROM=

# Africa's Talking SMS
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_ENVIRONMENT=production
AFRICASTALKING_SENDER_ID=

# Safaricom Daraja (M-Pesa STK Push)
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_TOKEN=
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
