NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Local development can use data/store.json. Production requires PostgreSQL.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_SIZE=10

# Private S3-compatible file storage (AWS S3, Cloudflare R2, or compatible).
# Leave STORAGE_ENDPOINT blank for AWS S3; set it and path-style mode for providers such as R2.
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false

# Local reminders run only when explicitly enabled. Production defaults to enabled.
REMINDER_SCHEDULER_ENABLED=true

# Required in production. The first run creates a private developer account.
SESSION_SECRET=
BOOTSTRAP_DEVELOPER_NAME=
BOOTSTRAP_DEVELOPER_EMAIL=
BOOTSTRAP_DEVELOPER_PASSWORD=

# Resend email
RESEND_API_KEY=
EMAIL_FROM=

# Africa's Talking SMS
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_ENVIRONMENT=production
AFRICASTALKING_SENDER_ID=

# Safaricom Daraja (M-Pesa STK Push)
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_TOKEN=
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
